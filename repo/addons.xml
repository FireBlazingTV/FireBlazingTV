<?xml version='1.0' encoding='UTF-8'?>
<addons>
  <addon id="repository.fireblazingtv" name="FireBlazingTV Repository" version="1.0.0" provider-name="Visualfx100">
    <extension point="xbmc.addon.repository" name="FireBlazingTV Repository">
      <dir>
        <info compressed="false">https://raw.githubusercontent.com/Visualfx100/FireBlazingTV/main/repo/addons.xml</info>
        <checksum>https://raw.githubusercontent.com/Visualfx100/FireBlazingTV/main/repo/addons.xml.md5</checksum>
        <datadir zip="true">https://raw.githubusercontent.com/Visualfx100/FireBlazingTV/main/repo/zips</datadir>
      </dir>
    </extension>
    <extension point="xbmc.addon.metadata">
      <summary lang="en_GB">FireBlazingTV Repository</summary>
      <description lang="en_GB">Repository for the FireBlazingTV Installer add-on, which installs the full FireBlazingTV Kodi build: addon pack, userdata, and media.</description>
      <platform>all</platform>
      <license>Public Domain</license>
      <source>https://github.com/Visualfx100/FireBlazingTV</source>
    </extension>
  </addon>
  <addon id="plugin.program.fireblazingtvinstaller" name="FireBlazingTV Installer" version="1.0.0" provider-name="Visualfx100">
    <requires>
      <import addon="xbmc.python" version="3.0.0" />
    </requires>
    <extension point="xbmc.python.script" library="default.py">
      <provides>executable</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
      <summary lang="en_GB">Installs the FireBlazingTV addon pack and settings</summary>
      <description lang="en_GB">Downloads and installs the FireBlazingTV addons, userdata (sources, favourites, skin/guisettings, profiles), background, and media directly from GitHub. Run this once after installing the FireBlazingTV Repository, then restart Kodi.</description>
      <platform>all</platform>
      <license>Public Domain</license>
      <source>https://github.com/Visualfx100/FireBlazingTV</source>
    </extension>
  </addon>
</addons>