<?xml version='1.0' encoding='UTF-8'?>
<addons>
  <addon id="repository.kodibuild26" name="Kodi Build 26 Repository" version="1.0.0" provider-name="Visualfx100">
    <extension point="xbmc.addon.repository" name="Kodi Build 26 Repository">
      <dir>
        <info compressed="false">https://raw.githubusercontent.com/Visualfx100/kodi-build-26/main/repo/addons.xml</info>
        <checksum>https://raw.githubusercontent.com/Visualfx100/kodi-build-26/main/repo/addons.xml.md5</checksum>
        <datadir zip="true">https://raw.githubusercontent.com/Visualfx100/kodi-build-26/main/repo/zips</datadir>
      </dir>
    </extension>
    <extension point="xbmc.addon.metadata">
      <summary lang="en_GB">Kodi Build 26 Repository</summary>
      <description lang="en_GB">Repository for the Kodi Build 26 Installer add-on, which installs Eric's full Kodi Build 26 addon pack, userdata, and media.</description>
      <platform>all</platform>
      <license>Public Domain</license>
      <source>https://github.com/Visualfx100/kodi-build-26</source>
    </extension>
  </addon>
  <addon id="plugin.program.kodibuild26installer" name="Kodi Build 26 Installer" version="1.0.0" provider-name="Visualfx100">
    <requires>
      <import addon="xbmc.python" version="3.0.0" />
    </requires>
    <extension point="xbmc.python.script" library="default.py">
      <provides>executable</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
      <summary lang="en_GB">Installs the Kodi Build 26 addon pack and settings</summary>
      <description lang="en_GB">Downloads and installs the Kodi Build 26 addons, userdata (sources, favourites, skin/guisettings, profiles), background, and media directly from GitHub. Run this once after installing the Kodi Build 26 Repository, then restart Kodi.</description>
      <platform>all</platform>
      <license>Public Domain</license>
      <source>https://github.com/Visualfx100/kodi-build-26</source>
    </extension>
  </addon>
</addons>